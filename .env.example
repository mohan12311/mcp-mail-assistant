# MCP Mail Assistant - example configuration
# Copy this file to .env and replace placeholders with your own values.

# Incoming mail (POP3 or IMAP)
POP_HOST=pop.example.com
POP_PORT=995
POP_USER=user@example.com
POP_PASS=replace_me
POP_SSL=true
POP_DELETE_AFTER_DOWNLOAD=false

# IMAP alternative
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_USER=user@example.com
# IMAP_PASS=replace_me

# LLM CLI
LLM_PROVIDER=claude
LLM_ALLOW_FALLBACK=false
# LLM_MODEL=sonnet

# Optional Slack integration
# SLACK_BOT_TOKEN=xoxb-replace_me
# SLACK_APP_TOKEN=xapp-replace_me
# SLACK_CHANNEL=#mail-alerts
# APPROVAL_CHANNEL=#task-approvals
# SLACK_APPROVER_USER_IDS=UXXXXXXXX

# Optional SMTP sending
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=replace_me
# SMTP_TLS=true
# SMTP_TIMEOUT_SECONDS=30

# Policy
INTERNAL_DOMAINS=example.com

# Operator
OPERATOR_POLL_INTERVAL=5.0
OPERATOR_INSTANCE_ID=operator-main
OPERATOR_MAX_BODY_LENGTH=10000
OPERATOR_MAX_ATTACHMENT_TEXT=5000

# Local storage
ATTACHMENT_DIR=./attachments
DB_PATH=./db/mail_agent.db

# Generic multi-user namespace
MAIL_AGENT_TENANT_ID=local
MAIL_AGENT_MAILBOX_ID=primary
